            { role: 'Event Planner', org: 'Xnergy Sport Carnival', icon: 'fa-calendar-check', desc: 'End-to-end logistics and on-site coordination for campus carnival.', when: 'Campus', rnd: 16 },
          ].map((e) => (
            <div key={e.rnd} className="exp-card tilt" onMouseMove={tilt.onMove} onMouseLeave={tilt.onLeave} onClick={() => openModal('https://picsum.photos/800/600?random=' + e.rnd, e.role + ' - ' + e.org)}>
              <div className="exp-top"><div className="exp-icon"><i className={'fas ' + e.icon} /></div><div><div className="exp-role">{e.role}</div><div className="exp-org">{e.org}</div></div></div>
              <div className="exp-desc">{e.desc}</div>
              <div className="exp-foot"><span className="exp-when">{e.when}</span><span className="exp-hint"><i className="fas fa-image" /> view</span></div>
            </div>
          ))}
        </div>
      </section>

      <section className="section" id="achievements">
        <div className="section-head">
          <div>
            <div className="section-label"><i className="fas fa-trophy" /> 05 - recognition</div>
            <h2 className="section-title">awards <span style={{ color: 'var(--muted)', fontFamily: 'var(--mono)', fontWeight: 500, fontSize: '.9rem' }}>.certifications</span></h2>
          </div>
          <p className="section-desc">Finalist recognitions plus certified first-aid competency.</p>
        </div>
        <div className="ach-grid reveal">
          <div className="ach-card tilt" onMouseMove={tilt.onMove} onMouseLeave={tilt.onLeave}><div className="ach-icon"><i className="fas fa-trophy" /></div><div><h4>XMUM Leader of the Year - Finalist</h4><p>Top student leaders for impact and service.</p></div></div>
          <div className="ach-card tilt" onMouseMove={tilt.onMove} onMouseLeave={tilt.onLeave}><div className="ach-icon"><i className="fas fa-lightbulb" /></div><div><h4>Best Innovative Event - Finalist</h4><p>Noted for creativity and engagement.</p></div></div>
          <div className="ach-card tilt" onMouseMove={tilt.onMove} onMouseLeave={tilt.onLeave}><div className="ach-icon"><i className="fas fa-medal" /></div><div><h4>Most Active Non-Sport Club - Finalist</h4><p>First Aid Society - consistent outreach.</p></div></div>
          <div className="ach-card tilt" onMouseMove={tilt.onMove} onMouseLeave={tilt.onLeave}><div className="ach-icon"><i className="fas fa-heart-pulse" /></div><div><h4>Basic Occupational First Aid, CPR and AED</h4><p>Certified emergency response competency.</p></div></div>
        </div>
      </section>

      <div className="cta reveal">
        <div className="cta-inner tilt" onMouseMove={tilt.onMove} onMouseLeave={tilt.onLeave}>
          <div>
            <h2>let&apos;s build <em>useful_</em></h2>
            <p>Open to internships and collaborations - AI, data, disciplined execution. Fast response via email and phone.</p>
          </div>
          <div className="cta-actions">
            <a className="cta-primary" href="mailto:yinkang90804586@gmail.com"><i className="fas fa-paper-plane" /> email_enson()</a>
            <a className="cta-secondary" href="tel:+60195897668"><i className="fas fa-phone" /> 019-589 7668</a>
            <a className="cta-secondary" href={import.meta.env.BASE_URL + 'Enson resume.pdf'} download><i className="fas fa-file-pdf" /> download cv.pdf</a>
          </div>
        </div>
      </div>

      <footer className="footer">
        <div>2026 Enson Chuan Chen Chun - <span style={{ color: 'var(--cyan)' }}>Skudai, Johor</span> - crafted with code and care - <i className="fas fa-code" style={{ color: 'var(--violet-2)' }} /></div>
        <div style={{ display: 'flex', gap: '1.2rem' }}>
          <a href="mailto:yinkang90804586@gmail.com"><i className="fas fa-envelope" /> email</a>
          <a href="tel:+60195897668"><i className="fas fa-phone" /> phone</a>
          <a href="#top"><i className="fas fa-arrow-up" /> top</a>
        </div>
      </footer>

      {modal.open && (
        <div className="modal" role="dialog" aria-modal="true" onClick={(e) => { if (e.target === e.currentTarget) closeModal() }}>
          <div className="modal-box">
            <div className="modal-head"><h3>{modal.caption}</h3><button onClick={closeModal}><i className="fas fa-xmark" /></button></div>
            <div className="modal-body">
              {!modal.fallback ? <img src={modal.src} alt="Preview" onError={() => setModal((m) => ({ ...m, fallback: true }))} /> : (
                <div className="modal-fallback"><i className="fas fa-image" /><p>Preview not available</p><p style={{ fontSize: '.78rem', maxWidth: '32ch' }}>Replace with local file e.g. <code>certs/spm.jpg</code></p></div>
              )}
            </div>
            <div className="modal-foot">Click outside or press Esc to close</div>
          </div>
        </div>
      )}
    </>
  )
}
